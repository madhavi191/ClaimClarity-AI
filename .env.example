# ==============================================================================
# ClaimClarity AI - Production & Development Environment Configuration
# ==============================================================================

# STORAGE_MODE: Backend storage mode. Supported values: LOCAL_DEMO, FIRESTORE.
# Defaults to LOCAL_DEMO when unset or empty.
# - LOCAL_DEMO: Persistent file-backed demo storage (.demo-data.json) with seed records.
# - FIRESTORE: Cloud Firestore via Firebase Admin SDK (requires explicit cloud project/credentials).
STORAGE_MODE="LOCAL_DEMO"

# GOOGLE_CLOUD_PROJECT: Google Cloud project ID (required if STORAGE_MODE=FIRESTORE)
GOOGLE_CLOUD_PROJECT=""

# FIRESTORE_DATABASE_ID: Firestore database identifier (defaults to '(default)')
FIRESTORE_DATABASE_ID="(default)"

# ==============================================================================
# Server-Side Authentication & Access Control (Backend Only)
# ==============================================================================
# REQUIRE_FIREBASE_AUTH: Enforces genuine Firebase ID token verification via Firebase Admin SDK.
# - false (default in development): Allows mock-tokens for local offline development.
# - true (enforced in production): Strictly forbids mock tokens; requires genuine Google Sign-In ID tokens.
REQUIRE_FIREBASE_AUTH="false"

# ADMIN_EMAIL: Authorized administrator email address.
# Users who sign in with this verified email are automatically granted Admin privileges.
ADMIN_EMAIL=("padduhoney150@gmail.com","madhavitapela22@gmail.com")

# JUDGE_ACCESS_CODE: Secret code used by bank credit officers to enroll for pipeline access.
JUDGE_ACCESS_CODE="CLAIM-VERIFY-2026"

# ==============================================================================
# Firebase Client SDK Configuration (Public Web Only - Safe in Client Bundle)
# Obtain these values from Firebase Console > Project Settings > General > Web Apps
# ==============================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ==============================================================================
# Gemini AI Configuration
# ==============================================================================
# GEMINI_API_KEY: Optional for live Gemini AI document verification.
# In AI Studio, this is securely injected from user secrets into the server environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
